<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PlexusXKeys</AssemblyName>
    <RootNamespace>PlexusXKeys</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="**\*.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="MainForm.cs" />
    <Compile Include="ActivateDialog.cs" />
    <Compile Include="KeyVault.cs" />

    <!-- Linked from the app rather than copied, so the key format, licence shape and
         signing can never drift between the tool that issues keys and the app that
         accepts them. Copies of these files drifted twice in the beta, each time
         producing keys no install could activate. -->
    <Compile Include="..\..\Licensing\PlanCatalog.cs" Link="Licensing\PlanCatalog.cs" />
    <Compile Include="..\..\Licensing\KeyCode.cs" Link="Licensing\KeyCode.cs" />
    <Compile Include="..\..\Licensing\MachineId.cs" Link="Licensing\MachineId.cs" />
    <Compile Include="..\..\Licensing\KeyRecord.cs" Link="Licensing\KeyRecord.cs" />
    <Compile Include="..\..\Licensing\KeyLedger.cs" Link="Licensing\KeyLedger.cs" />
    <Compile Include="..\..\Licensing\LicenceDocument.cs" Link="Licensing\LicenceDocument.cs" />
    <Compile Include="..\..\Licensing\LicenceSigner.cs" Link="Licensing\LicenceSigner.cs" />

    <!-- The app's own controls, linked for the same reason as the licence files above: this
         is the tool that mints keys, and it looked like a different product - stock grey
         buttons and Win32 text boxes. Linked rather than project-referenced, because a
         reference would drag the whole app (NVAPI, DirectX, the tray) into a tool that only
         needs to draw six controls. -->
    <Compile Include="..\..\Theme.cs" Link="Ui\Theme.cs" />
    <Compile Include="..\..\ThemePalette.cs" Link="Ui\ThemePalette.cs" />
    <Compile Include="..\..\ThemeCatalog.cs" Link="Ui\ThemeCatalog.cs" />
    <!-- ImagePalette only: it defines ImageTheme, which ThemeCatalog.SetCustom takes.
         CustomThemeService is deliberately not linked - it needs AppSettings, and the tool
         has no settings file. -->
    <Compile Include="..\..\Theming\ImagePalette.cs" Link="Ui\Theming\ImagePalette.cs" />
    <Compile Include="..\..\Glass.cs" Link="Ui\Glass.cs" />
    <Compile Include="..\..\UiHelpers.cs" Link="Ui\UiHelpers.cs" />
    <Compile Include="..\..\CardPanel.cs" Link="Ui\CardPanel.cs" />
    <Compile Include="..\..\Design\Tokens.cs" Link="Ui\Design\Tokens.cs" />
    <Compile Include="..\..\Design\Fonts.cs" Link="Ui\Design\Fonts.cs" />
    <Compile Include="..\..\Controls\GlassButton.cs" Link="Ui\Controls\GlassButton.cs" />
    <Compile Include="..\..\Controls\GlassTextBox.cs" Link="Ui\Controls\GlassTextBox.cs" />
    <Compile Include="..\..\Controls\GlassDropdown.cs" Link="Ui\Controls\GlassDropdown.cs" />
  </ItemGroup>

</Project>
