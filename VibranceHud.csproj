<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PlexusX</AssemblyName>
    <RootNamespace>VibranceHud</RootNamespace>
    <!-- Bumped for every release; the running app compares this against the newest
         GitHub release to decide whether to update itself. The display version in
         the bottom-left of the UI reads from AssemblyVersion via UpdateService. -->
    <Version>0.9.9</Version>
    <AssemblyVersion>0.9.9.0</AssemblyVersion>
    <FileVersion>0.9.9.0</FileVersion>
    <InformationalVersion>0.9.9</InformationalVersion>
    <ApplicationIcon>brand\PlexusX.ico</ApplicationIcon>

    <!-- Version resources. An executable with an empty publisher/product/copyright block is
         itself a heuristic signal - scanners weight "no identity at all" toward malware,
         because real software fills these in and droppers usually don't. Costs nothing and
         it's what shows in the file's Properties > Details tab. -->
    <Company>PlexusX</Company>
    <Product>PlexusX</Product>
    <Authors>PlexusX</Authors>
    <Copyright>Copyright © PlexusX</Copyright>
    <Description>Digital vibrance, per-game colour profiles and system tweaks for Windows.</Description>

    <!-- Self-contained so a friend's PC needs nothing pre-installed (no .NET Desktop
         Runtime download/prompt) - the app carries its own runtime. Without this, a plain
         `dotnet publish` produces a framework-dependent build that fails to launch with
         "missing files" on any machine that doesn't already have .NET 8 installed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <!-- Compression inside the single file is OFF deliberately.

         A compressed self-extracting bundle is the classic "packed executable" shape, and
         packing is one of the strongest generic-malware heuristics there is - it's how
         droppers hide their payload from static analysis. We were paying that reputational
         cost for nothing: the thing users actually download is the Inno Setup installer,
         and Inno already LZMA-compresses its payload. Compressing twice barely shrinks the
         installer while making the inner exe look packed.

         Turning this off makes the raw exe larger (~156MB) and the installer roughly the
         same size as before. It also removes the decompress-on-first-run step.

         Deliberately NOT using PublishTrimmed either: WinForms is not trim-safe (the
         designer and data binding resolve types by reflection), and Microsoft warn against
         it for WinForms apps. It would shrink further and then fail at runtime in whichever
         dialog happened to use the trimmed-away path. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>

    <!-- InvariantGlobalization would shave more off by dropping the ICU data, but it changes
         runtime behaviour rather than just packaging: any path that needs culture data throws
         at startup instead of falling back. Not worth shipping a change that can only be
         proven by launching the built exe, for a few extra MB on top of the ~55% compression
         already gets. -->
    <!-- <InvariantGlobalization>true</InvariantGlobalization> -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <!-- The PlexusX app icon + logo lockups, embedded so the window can load them at runtime. -->
  <ItemGroup>
    <EmbeddedResource Include="brand\PlexusX.ico" LogicalName="PlexusX.ico" />
    <EmbeddedResource Include="brand\png\logo-horizontal-white.png" LogicalName="logo-horizontal-white.png" />
    <EmbeddedResource Include="brand\png\logo-horizontal-black.png" LogicalName="logo-horizontal-black.png" />
  </ItemGroup>

  <!-- The test project lives under tests\ inside this folder; keep its sources out of
       the app's compilation (they reference xUnit, which the app doesn't). -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Compile Remove="Tools\**\*.cs" />
    <Compile Remove="Tools\**\*.csproj" />
    <Compile Remove="Tools\**\Program.cs" />
    <Compile Remove="Tools\**\KeyGenerator.csproj" />
    <Content Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- .Net wrapper for NVIDIA's public NVAPI - LGPL licensed, fine for this kind of use.
         https://github.com/falahati/NvAPIWrapper -->
    <PackageReference Include="NvAPIWrapper.Net" Version="0.8.1.101" />
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <PackageReference Include="SharpDX.D3DCompiler" Version="4.2.0" />
    <!-- WMI, used by the license hardware fingerprint. Not in the .NET 8 shared
         framework any more, so it has to come in as a package. -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="saturation.hlsl">
      <LogicalName>PlexusX.saturation.hlsl</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Expose internal types (DxDevice) to the test assembly for integration tests. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>VibranceHud.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>


  <ItemGroup>
    <EmbeddedResource Include="UpdateNotes\*.md" />
  </ItemGroup>
</Project>
