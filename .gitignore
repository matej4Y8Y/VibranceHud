# Build output
bin/
obj/
publish/
Releases/
installer/
artifacts/

# Shareable packages (built on demand, not source)
*.zip

# IDE / user files
.vs/
*.user

# OS cruft
Thumbs.db
.DS_Store

# Local scratch - never commit
.local/
chicken.jpg
installer/release-state.json
installer/create_release.py
installer/PlexusX-Setup-0.7.0.exe
installer/PlexusX-Setup-0.7.2.exe
*.tmp.py

# Screenshots. This repo is PUBLIC and screen captures routinely pick up whatever
# else was on screen - chat windows, terminal prompts with the Windows username,
# other apps. Never commit them; describe the UI in text instead.
docs/qa/screenshots/
*.png
!brand/**/*.png

# Debug logs (CEF browser, NVIDIA app, etc.) - never commit
debug.log
*.log

# Tools/KeyGenerator embedded copies - rebuilt from License/*.cs on demand
Tools/KeyGenerator/LicenseEmbed/

# Licence signing keys and the key ledger. These live in %LocalAppData%\PlexusXKeys and
# should never come near the repo, but this repo is PUBLIC and one stray copy of the
# private key lets anyone mint licences the app accepts - with no way to undo it short of
# re-keying every install. Belt and braces.
*.private
signing-key.*
keys.json
keys.json.bak
